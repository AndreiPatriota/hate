package pages

import (
	"hate/models"
	"hate/views/components"
	"hate/views/layouts"
)

templ ProdutosPage(produtos []models.Produto) {
	@layouts.Default("Produtos") {
		<script>
			function produtosPageData() {
			return {
				abreForm() {
					this.$refs.popup.showModal();
				}
			}
			}
  		</script>
		<div x-data="produtosPageData">
			<h2>Aqui está a página de produtos</h2>
			<button
				hx-get="/produtos/form"
				hx-target="#produtos-form"
				hx-swap="innerHTML"
				x-on:click="abreForm"
			>
				Adiciona
			</button>
			<div id="produtos">
				@components.Produtos(produtos)
			</div>
			<dialog x-ref="popup">
				<div id="produtos-form"></div>
			</dialog>
		</div>
	}
}
