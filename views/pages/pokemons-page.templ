package pages

import (
	"hate/models"
	"hate/views/components"
	"hate/views/layouts"
)

templ PokemonsPage(pokemons []models.Poke) {
	@layouts.Default("Pokemons") {
		<div
			x-data
			x-init="$el.addEventListener('htmx:responseError', (event) => {
				alert('Não achei esse Pokemon')
			})"
		>
			<form hx-post="/pokemons" hx-target="#pokemons" hx-swap="afterbegin">
				<input type="search" name="nomePokemon"/>
				<button type="submit">Busca</button>
			</form>
			<div id="pokemons">
				@components.Pokemons(pokemons)
			</div>
		</div>
	}
}
