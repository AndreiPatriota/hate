package components

import (
	"fmt"
	"hate/models"
)

templ ProdutosFormId(produto models.Produto) {
	<div x-data>
		<div class="btn-close-form-produto">
			<i @click="$dispatch('fecha-form')" class="material-icons">
				close
			</i>
		</div>
		<form
			hx-put={ string(templ.URL(fmt.Sprintf("/produtos/%v", produto.ID))) }
			hx-target={ fmt.Sprintf("#produto-%v", produto.ID) }
			hx-swap="outerHTML"
			@submit="$dispatch('fecha-form');"
		>
			s
			<label for="nome">
				Nome:
				<input
					id="nome"
					name="nome"
					type="text"
					value={ produto.Nome }
				/>
			</label>
			<label
				for="descricao"
			>
				Descrição:
				<input
					id="descricao"
					name="descricao"
					type="text"
					value={ produto.Descricao }
				/>
			</label>
			<input
				type="submit"
				value="Cadastra"
			/>
			<input
				type="reset"
				value="Limpa"
			/>
		</form>
	</div>
}
