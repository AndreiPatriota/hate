package components

import (
	"fmt"
	"hate/models"
)

templ ProdutosFormId(produto models.Produto) {
	<div
		x-data="{
        fechaForm() {
            setTimeout(()=>{
                this.$refs.nomeInput.value = ''
                this.$refs.descricaoInput.value = ''
                modalEstado = ''
            }, 100)
        }
    }"
	>
		<div class="btn-close-form-produto">
			<i
				x-on:click="fechaForm"
				class="material-icons"
			>
				close
			</i>
		</div>
		<form
			hx-put={ string(templ.URL(fmt.Sprintf("/produtos/%v", produto.ID))) }
			hx-target={ fmt.Sprintf("#produto-%v", produto.ID) }
			hx-swap="outterHTML"
			x-on:submit="fechaForm();"
		>
			<div class="field">
				<label for="nome" class="label">Nome</label>
				<div class="control">
					<input type="text" class="input"/>
				</div>
			</div>
			<label
				for="nome"
			>
				Nome:
				<input
					id="nome"
					name="nome"
					type="text"
					x-ref="nomeInput"
					value={ produto.Nome }
				/>
			</label>
			<label
				for="descricao"
			>
				Descrição:
				<input
					id="descricao"
					name="descricao"
					type="text"
					x-ref="descricaoInput"
					value={ produto.Descricao }
				/>
			</label>
			<input
				type="submit"
				value="Cadastra"
			/>
			<input
				type="reset"
				value="Limpa"
			/>
		</form>
	</div>
}
